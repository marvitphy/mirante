{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirante-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Needed for the `cloudflare:workers` module that DurableObject extends.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },

  // SQLite-backed Durable Objects are the ones available on the free plan.
  // A classic (KV-backed) migration here would force a paid plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "vars": {
    "MAX_PEERS_PER_ROOM": "8",
    "STUN_URLS": "stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302"
  }

  // TURN credentials are secrets, never vars:
  //   wrangler secret put CLOUDFLARE_TURN_KEY_ID
  //   wrangler secret put CLOUDFLARE_TURN_API_TOKEN
}
