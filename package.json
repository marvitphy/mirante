{
  "name": "tvmirante",
  "version": "0.1.38",
  "description": "Mirante — assistir junto, ao vivo, com os amigos. Compartilhamento de tela P2P em malha.",
  "main": "./out/main/index.js",
  "author": "Mirante",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "signal": "npm --prefix server run dev",
    "peer": "node scripts/peer.mjs",
    "icon": "node scripts/make-icon.mjs",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marvitphy/mirante.git"
  }
}
